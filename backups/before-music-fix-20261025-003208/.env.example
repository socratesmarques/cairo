# Copie para .env. Variáveis do ambiente têm precedência.
# demo não usa IA e não exige rede ou credenciais.
CAIRO_PROVIDER=demo
CAIRO_MODEL=
# Ollama: http://127.0.0.1:11434
# OpenAI-compatible: https://api.openai.com/v1
CAIRO_BASE_URL=
CAIRO_API_KEY=

# Gateway Free Claude Code: use CAIRO_PROVIDER=fcc.
# FCC_MODEL vazio acompanha o modelo padrão configurado no FCC.
FCC_BASE_URL=http://127.0.0.1:8082
FCC_AUTH_TOKEN=
FCC_MODEL=
CAIRO_MAX_OUTPUT_TOKENS=8192

# Caminhos relativos à pasta onde Cairo é iniciado.
CAIRO_WORKSPACE=./workspace
CAIRO_DATA_DIR=./storage
CAIRO_ALLOW_WRITE=false

# Timeout de chamadas ao provedor, em segundos; máximo de passos por agente.
CAIRO_TIMEOUT=90
CAIRO_MAX_STEPS=6

# Aplicativos e sites cadastrados; false desativa estas ações.
CAIRO_ALLOW_DESKTOP=true

# Cidade padrão do clima (exemplo); informe cidade e estado para evitar homônimos.
CAIRO_WEATHER_CITY=
# Leitura de texto/listagem em Downloads, Documentos, Área de Trabalho, Imagens,
# Músicas e Vídeos. Não permite escrever fora do workspace.
CAIRO_ALLOW_PERSONAL_FILES=false
# Consultas meteorológicas e leitura de páginas públicas HTTPS.
CAIRO_ALLOW_NETWORK=true

# Renderizar sites com JavaScript usando Playwright e Chrome instalado.
# Instalação: python -m pip install -e ".[browser]"
CAIRO_BROWSER_JAVASCRIPT=false
CAIRO_BROWSER_CHANNEL=chrome
# Operações nos arquivos das pastas pessoais e do workspace.
CAIRO_ALLOW_FILE_OPERATIONS=false
# Opcional: aliases para pastas extras, como {"projetos":"D:/Projetos"}.
CAIRO_FILE_ROOTS={}

# Permitir caminhos absolutos fora das raízes cadastradas, com permissões do Windows.
CAIRO_FULL_FILE_ACCESS=false
# Descoberta pelo menu Iniciar e registro; abertura por nome, ID ou caminho .exe.
CAIRO_DISCOVER_APPS=false
# Ler resultados na janela Google própria do Cairo; pode pedir verificação humana.
CAIRO_GOOGLE_SEARCH_READ=false

# Controle de janelas/campos/botoes pela acessibilidade do Windows.
# Dependencias opcionais: python -m pip install -e ".[browser,desktop]"
CAIRO_ALLOW_APP_CONTROL=false
# CMD e PowerShell: comando exato informado pelo usuario, com seus direitos Windows.
CAIRO_ALLOW_COMMANDS=false
CAIRO_COMMAND_TIMEOUT=30
# Navegador JavaScript com pagina persistente por conversa, cliques e preenchimento.
CAIRO_BROWSER_AUTOMATION=false
